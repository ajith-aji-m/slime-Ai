# ---------------------------------------------------------------------------
# Slime AI — environment
# Copy to `.env.local` and fill in. Never commit `.env.local`.
# All AI credentials are server-only — they are never sent to the browser.
# ---------------------------------------------------------------------------

# NVIDIA NIM (https://build.nvidia.com) — OpenAI-compatible.
# Without NVIDIA_API_KEY the NVIDIA models show as "coming soon" and the
# built-in mock provider is used.
NVIDIA_API_KEY=

# Optional. Defaults to the public NVIDIA integrate endpoint.
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional. JSON array to override / extend the NVIDIA model list.
# Each entry: { "id", "upstreamId", "name", "description?", "contextWindow?", "tier?" }
# NVIDIA_MODELS=[{"id":"nvidia/meta/llama-3.1-8b-instruct","upstreamId":"meta/llama-3.1-8b-instruct","name":"Llama 3.1 8B","contextWindow":128000,"tier":"free"}]

# Optional. Upstream request timeout in ms (default 60000).
# AI_REQUEST_TIMEOUT_MS=60000
